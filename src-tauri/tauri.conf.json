{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "easytier-game",
	"version": "1.5.5",
	"identifier": "com.tauri.easytier-game",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://127.0.0.1:5173",
		"beforeDevCommand": "pnpm dev"
	},
	"app": {
		"windows": [
			{
				"title": "easytier-game 1.5.5",
				"label": "main",
				"acceptFirstMouse": true,
				"minWidth": 360,
				"width": 400,
				"height": 720,
				"minHeight": 480,
				"maxHeight": 1200,
				"maxWidth": 600,
				"resizable": true,
				"fullscreen": false,
				"decorations": false,
				"center": true,
				"visible": false,
				"maximizable": false,
				"transparent": false
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": [
					"**"
				]
			}
		}
	},
	"plugins": {
		"cli": {
			"description": "easytier game CLI Plugin",
			"args": [
				{
					"name": "task-auto-start",
					"description": "easytier game autostart"
				}
			]
		}
	},
	"bundle": {
		"active": false,
		"targets": "all",
		"resources": [
			"easytier/config/",
			"easytier/icons/",
			"easytier/config_template.json",
			"easytier/tool/WinIPBroadcast.exe",
			"easytier/tool/ForceBindIP.exe",
			"easytier/tool/ForceBindIP64.exe",
			"easytier/tool/BindIP.dll",
			"easytier/tool/BindIP64.dll",
			"easytier/tool/MicrosoftEdgeWebview2Setup.exe",
			"easytier/easytier-cli.exe",
			"easytier/easytier-core.exe",
			"easytier/Packet.dll",
			"easytier/wintun.dll",
			"easytier/clear_local_data.bat",
			"帮助.txt",
			"uninstall.exe"
		],
		"windows": {
			"webviewInstallMode": {
				"type": "embedBootstrapper"
			},
			"wix": null,
			"nsis": null
		},
		"createUpdaterArtifacts": false,
		"icon": [
			"icons/icon.png",
			"icons/icon.rgba",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
