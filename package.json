{
	"name": "easytier-game",
	"private": true,
	"author": "leizi97",
	"description": "A simple network initiator based on Easytier",
	"version": "1.5.5",
	"scripts": {
		"dev": "vite --mode dev",
		"build": "vite build --mode prod",
		"release": "node zip.js",
		"release-win7": "node zip.js win7",
		"test": "node --test service/*.test.mjs tests/*.test.mjs",
		"service": "node service/server.mjs",
		"prepare:core": "node scripts/prepare-core.mjs",
		"build:desktop": "pnpm build && tauri build",
		"build:mac": "pnpm prepare:core && pnpm build && tauri build --bundles app,dmg",
		"typecheck": "vue-tsc --noEmit",
		"preview": "vite preview --host 127.0.0.1"
	},
	"devDependencies": {
		"@element-plus/icons-vue": "2.3.2",
		"@tauri-apps/api": "2.11.0",
		"@tauri-apps/cli": "2.11.1",
		"@tauri-apps/plugin-cli": "2.4.1",
		"@tauri-apps/plugin-clipboard-manager": "2.3.2",
		"@tauri-apps/plugin-dialog": "2.7.1",
		"@tauri-apps/plugin-fs": "2.5.1",
		"@tauri-apps/plugin-log": "2.8.0",
		"@tauri-apps/plugin-shell": "2.3.5",
		"@tauri-apps/plugin-window-state": "2.4.1",
		"@types/lodash-es": "4.17.12",
		"@vitejs/plugin-vue-jsx": "5.1.1",
		"@vueuse/core": "12.7.0",
		"archiver": "7.0.1",
		"element-plus": "2.13.0",
		"less": "4.2.1",
		"lodash-es": "4.17.21",
		"pinia": "3.0.4",
		"pinia-plugin-persistedstate": "4.7.1",
		"postcss": "8.5.6",
		"prettier": "3.7.4",
		"prettier-plugin-tailwindcss": "0.7.2",
		"tailwindcss": "3.4.19",
		"typescript": "5.9.3",
		"vite": "7.3.0",
		"vue": "3.5.25",
		"vue-tsc": "3.1.4",
		"@vitejs/plugin-vue": "6.0.3",
		"unplugin-vue-components": "30.0.0",
		"autoprefixer": "10.4.23",
		"@types/node": "24.10.1"
	},
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/noto-sans-sc": "^5.3.1",
		"is-ip": "^5.0.1",
		"lucide-vue-next": "^1.0.0",
		"vue-router": "4.6.4"
	}
