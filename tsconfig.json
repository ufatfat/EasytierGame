{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"jsx": "preserve",
		"jsxImportSource": "vue",
		"types": ["vite/client", "node", "element-plus/global", "pinia-plugin-persistedstate"],
		"allowJs": true,
		"checkJs": false,
		"esModuleInterop": true,
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true,
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./*"],
			"~/*": ["./*"]
		},
		"allowImportingTsExtensions": true
	},
	"include": [
		"**/*.vue",
		"components/**/*.ts",
		"composables/**/*.ts",
		"stores/**/*.ts",
		"utils/**/*.ts",
		"utils/**/*.tsx",
		"typings/**/*.d.ts",
		"main.ts",
		"router.ts",
		"vite.config.mts",
		"scripts/coordinator-dev.mts"
	],
	"exclude": ["node_modules", "dist", ".output", ".nuxt", "src-tauri", "service", "tests"]
}
