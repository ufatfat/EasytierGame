              "fontFamily": "$font",
              "fontSize": 11,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "T4THQn",
              "name": "Note",
              "fill": "$text-2",
              "content": "④ 房间大厅：在协调服务上发布/浏览公开房间，一键加入时自动填入服务器、房间名和密码",
              "fontFamily": "$font",
              "fontSize": 11,
              "fontWeight": "normal"
            },
